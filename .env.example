TGX_API_ID=
TGX_API_HASH=
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
TGX_OWNER_TOKEN=
# Optional encrypted server sessions: generate cryptography.fernet.Fernet.generate_key()
TGX_MASTER_KEY=
# Required only for docker compose --profile bot up -d
TGX_BOT_TOKEN=
TGX_BOT_ALLOWLIST=
# Optional self-hosted domain and signed large-archive links
TGX_DOMAIN=tgx.example.com
TGX_PUBLIC_URL=https://tgx.example.com
